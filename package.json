{
  "name": "agent-kanban",
  "version": "0.1.0",
  "description": "Kanban-board orchestration for AI agents and people. Local-only, no database.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "bin": { "agent-kanban": "dist/cli/index.js" },
  "scripts": {
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && chmod +x dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@preact/preset-vite": "^2.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "preact": "^10.25.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
